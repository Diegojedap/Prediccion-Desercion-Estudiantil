# Copia este archivo como .env y completa los valores reales.
# El archivo .env está excluido por .gitignore y NUNCA debe subirse al repositorio.

# ── Conexión a la base ──────────────────────────────────────────────────────

# Host o IP de la instancia de SQL Server
DB_HOST=

# Puerto de la instancia (por defecto 1433)
DB_PORT=1433

# Nombre de la base de datos
DB_NAME=

# ── Semántica de los datos ──────────────────────────────────────────────────

# Valor exacto del campo de estado que marca la deserción, en minúsculas.
# Es específico de cada instalación, por eso no se escribe en los notebooks.
# Si no coincide con ningún registro los notebooks fallan de forma explícita,
# en lugar de entrenar en silencio contra un target de solo ceros.
STATUS_DESERCION=

# ── Auditoría (opcional) ────────────────────────────────────────────────────

# Ruta a un export previo del dataset. Auditoria.ipynb lo necesita, y
# Auditoria_base.ipynb lo usa para comparar la estabilidad del target entre
# extracciones.
DATASET_AUDITORIA=

# Periodos con cobertura de la fuente de actividad en plataforma, separados por
# coma y en orden cronológico: el primero entrena y el último evalúa.
PERIODOS_PLATAFORMA=
